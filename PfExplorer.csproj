<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>0.3.1.0</Version>
    <Name>PF Explorer</Name>
    <Author>Nahuel Nillni</Author>
    <Punchline>Captures Party Finder listings and reports them to pfexplorer for cross-client search.</Punchline>
    <Description>Captures Party Finder listings and shares them to pfexplorer.com for cross-data-center search. Click a listing to jump to it in-game, travel to reach ones on other data centers, and get notified on new matches, party changes, and closures.</Description>
    <PackageProjectUrl>https://pfexplorer.com</PackageProjectUrl>
  </PropertyGroup>

  <!-- Category icons for the alert match list — copied from website/icons/,
       kept in sync manually since the two projects don't share a build. -->
  <ItemGroup>
    <None Include="icons\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
